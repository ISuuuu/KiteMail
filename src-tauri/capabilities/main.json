{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capabilities strictly bound to the KiteMail main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "allow-show-window-system-menu",
    "allow-main-bootstrap",
    "allow-list-messages",
    "allow-list-thread-summaries",
    "allow-open-message",
    "allow-set-reader-layout",
    "allow-update-main-preferences",
    "allow-refresh-mail",
    "allow-unlock-app",
    "allow-lock-app",
    "allow-set-message-seen",
    "allow-set-message-flagged",
    "allow-allow-remote-images",
    "allow-load-older-messages",
    "allow-archive-message",
    "allow-delete-message",
    "allow-mark-message-spam",
    "allow-unmark-message-spam",
    "allow-move-message",
    "allow-undo-message-move",
    "allow-list-tags",
    "allow-set-message-tags",
    "allow-get-reader-view-options",
    "allow-set-reader-view-options",
    "allow-find-in-reader",
    "allow-close-main-window",
    "allow-quit-app",
    "allow-list-drafts",
    "allow-save-draft",
    "allow-delete-draft",
    "allow-send-mail",
    "allow-undo-send-mail",
    "allow-list-outbox",
    "allow-retry-outbox-item",
    "allow-delete-outbox-item",
    "allow-list-accounts",
    "allow-verify-account",
    "allow-save-account",
    "allow-delete-account",
    "allow-set-account-enabled",
    "allow-start-microsoft-oauth",
    "allow-list-cached-attachments",
    "allow-fetch-attachment-preview",
    "allow-save-attachment",
    "allow-save-all-attachments",
    "allow-open-attachment",
    "allow-pick-directory",
    "allow-get-message-print-html",
    "allow-open-message-window",
    "allow-list-contacts",
    "allow-save-contact",
    "allow-delete-contact",
    "allow-import-contacts",
    "allow-export-contacts",
    "allow-get-full-preferences",
    "allow-update-full-preferences",
    "allow-set-app-lock-passcode",
    "allow-manage-trusted-senders",
    "allow-clear-body-caches",
    "allow-check-app-update",
    "allow-open-settings-window"
  ]
}
