{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capabilities strictly bound to the KiteMail main preview window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-main-bootstrap",
    "allow-list-messages",
    "allow-open-message",
    "allow-set-reader-layout",
    "allow-update-main-preferences",
    "allow-refresh-mail"
  ]
}
